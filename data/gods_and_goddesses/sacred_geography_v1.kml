  <Placemark id="sacred_geography.3">
	<name>Niyamgiri</name>
	<Style><LineStyle><color>FF232323</color><width>0.737006</width></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#sacred_geography">
		<SimpleData name="fid">3</SimpleData>
		<SimpleData name="local_name">नियमगिरी</SimpleData>
		<SimpleData name="district">Rayagada / Kalahandi</SimpleData>
		<SimpleData name="state">Odisha</SimpleData>
		<SimpleData name="deity">Niyam Raja — supreme deity of the Dongria Kondh, believed to reside in the Niyamgiri hills</SimpleData>
		<SimpleData name="significance">Sacred abode of Niyam Raja; site of a landmark 2013 Supreme Court-mandated gram sabha referendum where villages rejected Vedanta's mining bid</SimpleData>
		<SimpleData name="mining_company">Vedanta Ltd / Odisha Mining Corporation (OMC)</SimpleData>
	</SchemaData></ExtendedData>
