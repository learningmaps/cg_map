  <Placemark id="sacred_geography.5">
	<name>Bailadilla</name>
	<Style><LineStyle><color>FF232323</color><width>0.737006</width></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#sacred_geography">
		<SimpleData name="fid">5</SimpleData>
		<SimpleData name="local_name">बैलाडीला</SimpleData>
		<SimpleData name="district">Dantewada</SimpleData>
		<SimpleData name="state">Chhattisgarh</SimpleData>
		<SimpleData name="deity">Pitod Devi, wife of nature god Nandraj — the hill is revered as her shrine</SimpleData>
		<SimpleData name="significance">Considered the abode of Nandaraj, the tribal nature god, by roughly 200 surrounding tribal villages</SimpleData>
		<SimpleData name="mining_company">NMDC (state-run); recent protests specifically target proposed Adani mining on Deposit 13</SimpleData>
	</SchemaData></ExtendedData>
