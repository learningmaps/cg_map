  <Placemark id="sacred_geography.2">
	<name>Surjagadh</name>
	<Style><LineStyle><color>FF232323</color><width>0.737006</width></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#sacred_geography">
		<SimpleData name="fid">2</SimpleData>
		<SimpleData name="local_name">सुरजागढ</SimpleData>
		<SimpleData name="district">Gadchiroli</SimpleData>
		<SimpleData name="state">Maharashtra</SimpleData>
		<SimpleData name="deity">Thakurdeo, &quot;God of Gods,&quot; revered by Maria/Madia Gonds; legend holds he revealed this mountain (Surjagad) to them after leading a hunter here in the form of a wild boar</SimpleData>
		<SimpleData name="significance">Sacred to roughly 70 villages of the Surjagad Elaka, closely linked to the Madia Gonds' gods of origin</SimpleData>
		<SimpleData name="mining_company">Lloyds Metals and Energy Ltd (LMEL). a separate proposed lease to Gopani Iron Ore &amp; Power Ltd</SimpleData>
	</SchemaData></ExtendedData>
