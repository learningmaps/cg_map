		<SimpleData name="local_name">रावघाट</SimpleData>
		<SimpleData name="district">	Kanker / Narayanpur</SimpleData>
		<SimpleData name="state">Chhattisgarh</SimpleData>
		<SimpleData name="deity">Raja Rao</SimpleData>
		<SimpleData name="significance">Home to tribal communities resisting displacement from these mineral-rich hills, though their struggle has received comparatively little media attention</SimpleData>
		<SimpleData name="mining_company">SAIL / Bhilai Steel Plant (BSP)</SimpleData>
	</SchemaData></ExtendedData>
