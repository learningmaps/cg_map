  <Placemark id="sacred_geography.4">
	<name>Sijimali</name>
	<Style><LineStyle><color>FF232323</color><width>0.737006</width></LineStyle><PolyStyle><fill>0</fill></PolyStyle></Style>
	<ExtendedData><SchemaData schemaUrl="#sacred_geography">
		<SimpleData name="fid">4</SimpleData>
		<SimpleData name="local_name">सिजिमाली</SimpleData>
		<SimpleData name="district">Rayagada / Kalahandi</SimpleData>
		<SimpleData name="state">Odisha</SimpleData>
		<SimpleData name="deity">Teej Raja (also called Tij Raja) — a living deity associated with the hill's sacred and biodiversity significance</SimpleData>
		<SimpleData name="significance">A sacred abode of the supreme deity for the Kondh community, sitting amid reserved forests and water bodies</SimpleData>
		<SimpleData name="mining_company">Vedanta Limited</SimpleData>
	</SchemaData></ExtendedData>
